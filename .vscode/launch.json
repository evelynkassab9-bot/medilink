{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch MediLink Web Server",
      "program": "${workspaceFolder}/scripts/start.js",
      "args": ["mysql"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Open MediLink Website",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Run MediLink Website",
      "configurations": ["Launch MediLink Web Server", "Open MediLink Website"]
    }
  ]
}
